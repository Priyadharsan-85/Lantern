APP_DOMAIN=api.lantern.example.com
DASHBOARD_DOMAIN=lantern.example.com
TLS_EMAIL=ops@lantern.example.com

PGHOST=postgres
PGPORT=5432
PGDATABASE=lantern
PGUSER=postgres
PGPASSWORD=replace_with_a_strong_password

REDIS_HOST=redis
REDIS_PORT=6379

NODE_ENV=production
COLLECTOR_API_KEY=replace_with_a_strong_random_key
CORS_ORIGIN=https://lantern.example.com
DASHBOARD_ORIGIN=https://lantern.example.com
DASHBOARD_AUTH_USER=admin
DASHBOARD_AUTH_PASSWORD=replace_with_a_strong_password
SESSION_SECRET=replace_with_a_long_random_secret
VITE_COLLECTOR_URL=https://api.lantern.example.com

SPANS_RATE_LIMIT_MAX=200
SPANS_RATE_LIMIT_WINDOW_MS=60000
SDK_MAX_QUEUE_SIZE=5000
PAYMENT_FAILURE_RATE=0
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=replace_with_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=replace_with_stripe_webhook_signing_secret
PAYMENT_CURRENCY=usd
PAYMENT_PRODUCT_NAME=Lantern order
STRIPE_SUCCESS_URL='https://lantern.example.com/?checkout=success&session_id={CHECKOUT_SESSION_ID}'
STRIPE_CANCEL_URL='https://lantern.example.com/?checkout=cancelled'

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_a_strong_grafana_password

ALERT_EMAIL=ops@lantern.example.com
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
