PGHOST=localhost
PGPORT=5432
PGDATABASE=lantern
PGUSER=postgres
PGPASSWORD=postgres
REDIS_HOST=localhost
REDIS_PORT=6379
NODE_ENV=development

# Dashboard — URL the browser uses to reach the collector
# In Docker, set this to your server's IP/domain, e.g. http://my-server.com:4000
# With Nginx proxy (default docker-compose), use /api
VITE_COLLECTOR_URL=http://localhost:4000

# CORS — restrict to your dashboard origin in production
# Example: CORS_ORIGIN=https://lantern.yourdomain.com
CORS_ORIGIN=*