# ──────────────────────────────────────────────────────────────────────────────
# Lantern — Environment Variables
# Copy this file to .env and fill in all REQUIRED values before starting.
# ──────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL (REQUIRED in production) ───────────────────────────────────────
PGHOST=localhost
PGPORT=5432
PGDATABASE=lantern
PGUSER=postgres
# REQUIRED — no default is provided in production. Use a strong password.
PGPASSWORD=change_me_in_production

# ── Redis (REQUIRED) ──────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Node environment ──────────────────────────────────────────────────────────
# Set to "production" in all deployed environments.
NODE_ENV=production

# ── Collector API key (REQUIRED in production) ───────────────────────────────
# When set, all SDK clients and HTTP callers must send this in the x-api-key header.
# Use a long random value in production and keep it out of source control.
COLLECTOR_API_KEY=replace_with_a_strong_random_key

# ── CORS (REQUIRED in production) ─────────────────────────────────────────────
# Lock this to your dashboard's domain in production.
# Example: CORS_ORIGIN=https://lantern.yourdomain.com
# Wildcard (*) is only safe for local development.
CORS_ORIGIN=https://lantern.yourdomain.com

# ── Rate limiting for /spans endpoint ─────────────────────────────────────────
# Max span batches per IP per window (default: 200 requests per minute)
SPANS_RATE_LIMIT_MAX=200
SPANS_RATE_LIMIT_WINDOW_MS=60000

# ── SDK span queue ────────────────────────────────────────────────────────────
# Max in-memory spans before oldest are dropped (prevents memory leaks)
SDK_MAX_QUEUE_SIZE=5000

# ── Payment service ───────────────────────────────────────────────────────────
# Failure rate for demo chaos testing (0.0 = never fail, 0.1 = 10% chance)
# Set to 0 in production.
PAYMENT_FAILURE_RATE=0
PAYMENT_PROVIDER=simulated

# Required for production when PAYMENT_PROVIDER=stripe
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# PAYMENT_CURRENCY=usd
# PAYMENT_PRODUCT_NAME=Lantern order
# STRIPE_SUCCESS_URL='https://lantern.example.com/?checkout=success&session_id={CHECKOUT_SESSION_ID}'
# STRIPE_CANCEL_URL='https://lantern.example.com/?checkout=cancelled'

# Local Stripe sandbox testing (docker-compose.stripe-local.yaml)
# Add real sandbox values to your ignored .env file; never commit them.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...  # Printed by `stripe listen`
# PAYMENT_CURRENCY=usd
# PAYMENT_PRODUCT_NAME=Lantern order
# STRIPE_SUCCESS_URL='http://localhost:8080/?checkout=success&session_id={CHECKOUT_SESSION_ID}'
# STRIPE_CANCEL_URL='http://localhost:8080/?checkout=cancelled'

# ── Dashboard — URL the browser uses to reach the collector ───────────────────
# In Docker with Nginx proxy (default): leave this unset or use /api
# For local dev:
VITE_COLLECTOR_URL=http://localhost:4000

# ── Public dashboard origin used by API Gateway in production ─────────────────
# Example: https://lantern.yourdomain.com
DASHBOARD_ORIGIN=https://lantern.yourdomain.com

# Dashboard authentication (REQUIRED in production)
DASHBOARD_AUTH_USER=admin
DASHBOARD_AUTH_PASSWORD=replace_with_a_strong_password
SESSION_SECRET=replace_with_a_long_random_secret