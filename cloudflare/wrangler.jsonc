{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lantern-tracing",
  "main": "src/index.js",
  "compatibility_date": "2026-10-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "MAX_DAILY_SPANS": "2000",
    "MAX_MONTHLY_SPANS_PER_PROJECT": "100000",
    "SPAN_RETENTION_DAYS": "7"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lantern-tracing",
      "database_id": "replace-with-created-d1-database-id",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "directory": "../dashboard/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/auth/*",
      "/projects*",
      "/spans",
      "/traces*",
      "/health"
    ]
  },
  "triggers": {
    "crons": ["17 3 * * *"]
  }
}
